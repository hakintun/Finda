{
  "name": "finda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:member3 && npm run test:engine",
    "test:buyer": "vitest run",
    "test:member3": "tsx --test tests/*.test.ts",
    "test:engine": "node --test demo/*.test.js",
    "seed": "node scripts/build-seed.mjs",
    "reset": "node scripts/reset-db.mjs",
    "check": "node scripts/pre-push-check.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "tsx": "^4.23.15"
  }
}
